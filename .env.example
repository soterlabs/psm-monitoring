# Required. An Ethereum mainnet JSON-RPC URL.
ETH_RPC=https://eth-mainnet.example/v1/replace-me

# Required for live PSM3 reserve verification.
BASE_RPC=https://base.example/v1/replace-me
ARBITRUM_RPC=https://arbitrum.example/v1/replace-me
OPTIMISM_RPC=https://optimism.example/v1/replace-me
UNICHAIN_RPC=https://unichain.example/v1/replace-me

# Optional for the web service; required by the daily snapshot worker.
# Railway supplies this through a reference to the project's Postgres service.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional defaults shown below.
PORT=3000
PSM_ADDRESS=0xf6e72Db5454dd049d0788e411b06CfAF16853042
USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
LIMIT_USDC=4000000000
YELLOW_PERCENT=95
ORANGE_PERCENT=90
POLL_INTERVAL_SECONDS=60
STALE_AFTER_SECONDS=180
SLACK_CHECK_INTERVAL_SECONDS=600
SLACK_REMINDER_SECONDS=3600
ALERT_REMINDER_SECONDS=3600

# Optional Slack Incoming Webhook. Keep this secret and configure it only in Railway.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me

# Optional legacy generic JSON/Slack/Discord webhook, independent of Slack policy alerts.
# ALERT_WEBHOOK_URL=
