{
  "name": "psm-monitoring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live monitoring for the Sky LitePSM USDC balance on Ethereum",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "cron": "node dist/cron.js",
    "slack-alert": "node dist/slack-cron.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "viem": "^2.37.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.23.1",
    "railway": "^3.11.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
